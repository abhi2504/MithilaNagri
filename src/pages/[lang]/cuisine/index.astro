---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHero from '../../../components/content/SectionHero.astro';
import EntryCard from '../../../components/content/EntryCard.astro';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { localizedPath } from '../../../i18n/utils';
import { getSection } from '../../../lib/constants';
import { getLocalizedEntries } from '../../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const s = getSection('cuisine')!;
const entries = await getLocalizedEntries('dishes', lang);
const intro =
  'Cooked in mustard oil and built on rice, fish, lentils and the fertile produce of a watery land, Maithil cuisine runs from the everyday dahi-chura to the festive thekua and the GI-tagged makhana. As the proverb has it: Maachh, Paan, Makhaan — fish, betel and fox-nut are the soul of Mithila.';
---
<BaseLayout title={s.labels[lang]} description={s.blurbs[lang]} accent={s.accent} section="cuisine">
  <SectionHero lang={lang} title={s.labels[lang]} blurb={s.blurbs[lang]} icon={s.icon} crumbs={[{ label: s.labels[lang] }]} />
  <div class="container-wide hub" data-pagefind-body>
    <p class="hub-intro">{intro}</p>
    <ul class="card-grid" role="list">
      {
        entries.map((e: any) => (
          <li>
            <EntryCard
              href={localizedPath(lang, `/cuisine/${e.data.slug}/`)}
              title={e.data.title}
              summary={e.data.summary}
              cover={e.data.cover}
              tag={e.data.category}
              icon="pot"
            />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
