---
import EntryLayout from '../../../layouts/EntryLayout.astro';
import { render } from 'astro:content';
import { LOCALES, type Locale } from '../../../i18n/locales';
import { getEntryKeys, getLocalizedEntry } from '../../../lib/content';

export async function getStaticPaths() {
  const slugs = await getEntryKeys('artStyles');
  return LOCALES.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const entry = await getLocalizedEntry('artStyles', slug, lang);
if (!entry) return Astro.redirect('/404');
const d: any = entry.data;
const { Content } = await render(entry);
const facts: any[] = [
  d.community && { label: 'Community', value: d.community },
  d.village && { label: 'Village', value: d.village },
  d.motifs?.length && { label: 'Motifs', value: d.motifs.join(', ') },
].filter(Boolean);
---
<EntryLayout
  lang={lang}
  section="art"
  slug={slug}
  tags={d.tags}
  title={d.title}
  summary={d.summary}
  cover={d.cover}
  gallery={d.gallery}
  facts={facts}
  sources={d.sources}
>
  <Content />
</EntryLayout>
