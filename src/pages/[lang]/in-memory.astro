<script>
  // Gentle fade-up as each block enters view. Progressive enhancement: with no
  // JS (or reduced-motion) everything is simply visible from the start.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = Array.from(document.querySelectorAll('[data-reveal]'));
  if (!reduce && 'IntersectionObserver' in window && els.length) {
    const reveal = (el: Element) => {
      el.classList.remove('reveal-init');
      el.classList.add('reveal-in');
    };
    els.forEach((el) => el.classList.add('reveal-init'));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            reveal(e.target);
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
    // Safety net — content must never stay invisible. If anything is still hidden
    // after a few seconds (no-scroll, unusual viewport, print, IO edge cases),
    // reveal it anyway.
    setTimeout(() => els.forEach((el) => el.classList.contains('reveal-init') && reveal(el)), 3500);
  }
</script>
