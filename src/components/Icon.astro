---
// Inline motif icons (currentColor). Used for section icons, nav, and accents.
interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
}
const { name, size = 24, class: className = '', title } = Astro.props;

// Minimal hand-stylised Mithila motifs. fill="none" stroke-based unless noted.
const PATHS: Record<string, string> = {
  fish: `<path d="M2 12c4-6 12-6 16 0-4 6-12 6-16 0Z"/><path d="M18 12l4-3v6l-4-3Z"/><circle cx="7" cy="11" r="1" fill="currentColor" stroke="none"/>`,
  lotus: `<path d="M12 20c-5 0-8-3-8-3s2-5 8-5 8 5 8 5-3 3-8 3Z"/><path d="M12 12c-2-3-1-7 0-9 1 2 2 6 0 9Z"/><path d="M12 12c-3-1-6-1-8 0M12 12c3-1 6-1 8 0"/>`,
  sun: `<circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M5 5l1.8 1.8M17.2 17.2 19 19M19 5l-1.8 1.8M6.8 17.2 5 19"/>`,
  temple: `<path d="M12 2l3 4H9l3-4Z"/><path d="M7 6h10l-1 4H8l-1-4Z"/><path d="M6 10h12v4H6z"/><path d="M5 14h14v7H5z"/><path d="M11 21v-4h2v4"/>`,
  arch: `<path d="M5 21V9a7 7 0 0 1 14 0v12"/><path d="M9 21v-8a3 3 0 0 1 6 0v8"/>`,
  script: `<path d="M5 19l9-13 4 3-9 13-5 1 1-4Z"/><path d="M13 7l4 3"/>`,
  pot: `<path d="M5 11h14"/><path d="M6 11a6 6 0 0 0 12 0"/><path d="M9 11V9a3 3 0 0 1 6 0v2"/><path d="M12 6V4"/>`,
  person: `<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-4 3-6 7-6s7 2 7 6"/>`,
  peacock: `<path d="M12 21c0-6-5-8-5-13a5 5 0 0 1 10 0c0 5-5 7-5 13Z"/><circle cx="12" cy="8" r="2"/><circle cx="12" cy="8" r="0.6" fill="currentColor" stroke="none"/>`,
  hut: `<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>`,
  kohbar: `<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M12 16c-3 0-5-2-5-2s1-3 5-3 5 3 5 3-2 2-5 2Z"/><path d="M12 11c-1-2 0-4 0-5 1 1 1 3 0 5Z"/>`,
  search: `<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>`,
  moon: `<path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z"/>`,
  book: `<path d="M12 6c-2-1.3-5-2-8.5-2V18c3.5 0 6.5.7 8.5 2 2-1.3 5-2 8.5-2V4c-3.5 0-6.5.7-8.5 2Z"/><path d="M12 6v14"/>`,
  globe: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"/>`,
  arrow: `<path d="M5 12h14M13 6l6 6-6 6"/>`,
  pin: `<path d="M12 21s-6-5.7-6-10a6 6 0 0 1 12 0c0 4.3-6 10-6 10Z"/><circle cx="12" cy="11" r="2.2"/>`,
};

const inner = PATHS[name] ?? PATHS.fish;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  set:html={inner}
/>
