---
import { getMedia } from '../../lib/media';

interface Props {
  ids: string[];
  class?: string;
}
const { ids, class: className = '' } = Astro.props;
const items = ids.map((id) => ({ id, ...getMedia(id) }));
---
<ul class:list={['gallery', className]} role="list">
  {
    items.map((it) => (
      <li>
        <button
          type="button"
          class="gallery-thumb js-lightbox-trigger kohbar-frame"
          data-src={it.src}
          data-alt={it.alt}
          data-credit={`${it.credit.source}${it.credit.author ? ` · ${it.credit.author}` : ''} · ${it.credit.license}`}
          data-href={it.credit.sourceUrl}
          aria-label={`View image: ${it.alt}`}
        >
          <img
            src={it.src}
            alt={it.alt}
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null;this.src='/icons/placeholder.svg';this.classList.add('img-fallback');"
          />
        </button>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
  }
  .gallery-thumb {
    padding: 0;
    border: none;
    cursor: pointer;
    background: none;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    width: 100%;
  }
  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gallery-thumb:hover img {
    transform: scale(1.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-thumb img {
      transition: none;
    }
  }
</style>
