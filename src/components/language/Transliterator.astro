---
// Live Devanagari → Tirhuta transliterator (client-side).
---
<div class="xlit kohbar-frame">
  <div class="xlit-grid">
    <label class="xlit-field">
      <span class="xlit-label">Type in Devanagari</span>
      <input id="xlit-in" type="text" value="मिथिला" autocomplete="off" spellcheck="false" dir="ltr" />
    </label>
    <div class="xlit-arrow" aria-hidden="true">→</div>
    <div class="xlit-field">
      <span class="xlit-label">Tirhuta (Mithilakshar)</span>
      <output id="xlit-out" class="font-tirhuta xlit-output"></output>
    </div>
  </div>
  <div class="xlit-examples">
    <span>Try:</span>
    <button type="button" data-word="मिथिला">मिथिला</button>
    <button type="button" data-word="सीता">सीता</button>
    <button type="button" data-word="विद्यापति">विद्यापति</button>
    <button type="button" data-word="मैथिली">मैथिली</button>
  </div>
  <p class="xlit-note">
    Character-level transliteration; conjuncts are shaped by the Noto Sans Tirhuta font.
    If the Tirhuta letters don’t appear, your device may lack the font.
  </p>
</div>

<style>
  .xlit {
    background: var(--surface);
    padding: 1.5rem;
  }
  .xlit-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }
  .xlit-label {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  #xlit-in {
    width: 100%;
    font-family: var(--font-deva);
    font-size: 1.6rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
  }
  .xlit-arrow {
    font-size: 1.6rem;
    color: var(--accent);
  }
  .xlit-output {
    display: block;
    min-height: 3rem;
    font-size: 2rem;
    line-height: 1.3;
    padding: 0.4rem 0.2rem;
    word-break: break-word;
  }
  .xlit-examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.1rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .xlit-examples button {
    font-family: var(--font-deva);
    font-size: 1rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }
  .xlit-examples button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .xlit-note {
    margin: 0.9rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 620px) {
    .xlit-grid {
      grid-template-columns: 1fr;
    }
    .xlit-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }
</style>

<script>
  import { toTirhuta } from '../../data/tirhuta';
  const input = document.getElementById('xlit-in') as HTMLInputElement | null;
  const output = document.getElementById('xlit-out');
  function update() {
    if (input && output) output.textContent = toTirhuta(input.value);
  }
  input?.addEventListener('input', update);
  document.querySelectorAll<HTMLButtonElement>('.xlit-examples button').forEach((b) => {
    b.addEventListener('click', () => {
      if (input) {
        input.value = b.dataset.word || '';
        update();
        input.focus();
      }
    });
  });
  update();
</script>
