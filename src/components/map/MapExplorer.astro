---
import { MAP_TYPES, MAP_POINTS, RIVERS, DISTRICTS, BOUNDS } from '../../data/map';
import { getMedia } from '../../lib/media';
import { localizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/locales';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const W = 1040;
const H = 670;
const { lng0, lng1, lat0, lat1 } = BOUNDS;
const px = (lng: number) => ((lng - lng0) / (lng1 - lng0)) * W;
const py = (lat: number) => ((lat1 - lat) / (lat1 - lat0)) * H;

const rivers = RIVERS.map((r) => ({
  name: r.name,
  d: r.path.map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(1)} ${py(p[1]).toFixed(1)}`).join(' '),
  lx: px(r.path[1][0]),
  ly: py(r.path[1][1]),
}));
const districts = DISTRICTS.map((d) => ({ name: d.name, x: px(d.lng), y: py(d.lat) }));
const markers = MAP_POINTS.map((p) => ({
  ...p,
  x: px(p.lng),
  y: py(p.lat),
  color: MAP_TYPES[p.type].color,
  emoji: MAP_TYPES[p.type].emoji,
}));
const typesPresent = Object.keys(MAP_TYPES).filter((t) => MAP_POINTS.some((p) => p.type === t));

const clientData: Record<string, any> = {};
for (const p of MAP_POINTS) {
  clientData[p.id] = {
    name: p.name,
    typeLabel: MAP_TYPES[p.type].label,
    color: MAP_TYPES[p.type].color,
    emoji: MAP_TYPES[p.type].emoji,
    blurb: p.blurb,
    img: p.img ? getMedia(p.img).src : null,
    href: p.link ? localizedPath(lang, `/${p.link.section}/${p.link.slug}/`) : null,
  };
}

// India–Nepal border + a schematic highway
const border = [[84.3, 26.62], [85.4, 26.74], [86.5, 26.78], [88.1, 26.55]] as [number, number][];
const borderD = border.map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(1)} ${py(p[1]).toFixed(1)}`).join(' ');
const road = [[84.3, 26.02], [85.4, 26.12], [86.6, 26.0], [88.1, 25.88]] as [number, number][];
const roadD = road.map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(1)} ${py(p[1]).toFixed(1)}`).join(' ');
---
<div class="map-explorer">
  <div class="map-toolbar">
    <input id="map-search" type="search" placeholder="Search the map…" aria-label="Search the map" autocomplete="off" />
    <div class="map-filters" role="group" aria-label="Filter by type">
      {
        typesPresent.map((t) => (
          <button type="button" class="chip active" data-filter={t} style={`--mc:${MAP_TYPES[t].color}`} aria-pressed="true">
            <span class="chip-emoji">{MAP_TYPES[t].emoji}</span>
            {MAP_TYPES[t].label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="map-stage">
    <div class="map-canvas">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Map of the Mithila region" preserveAspectRatio="xMidYMid meet">
        <!-- land + bands -->
        <rect x="0" y="0" width={W} height={H} fill="#e9dcbb" />
        <path d={`M0,0 H${W} V${py(26.95)} Q${W * 0.5},${py(27.2)} 0,${py(27.0)} Z`} fill="#dcc99c" />
        <path d={`M0,${py(25.45)} Q${W * 0.5},${py(25.25)} ${W},${py(25.45)} V${H} H0 Z`} fill="#cfd6b4" />
        <text x="14" y={py(27.25)} class="band-label">HIMALAYAN FOOTHILLS</text>
        <text x="14" y={py(25.2)} class="band-label">GANGA PLAIN</text>

        <!-- forests -->
        <g class="forest">
          {[[84.7, 27.1], [85.6, 27.15], [86.7, 27.1], [87.5, 27.0]].map((c) => (
            <text x={px(c[0])} y={py(c[1])} text-anchor="middle">🌳</text>
          ))}
        </g>

        <!-- rivers -->
        <g class="rivers">
          {rivers.map((r) => (
            <>
              <path d={r.d} />
              <text x={r.lx + 4} y={r.ly} class="river-label">{r.name}</text>
            </>
          ))}
        </g>

        <!-- schematic highway -->
        <path d={roadD} class="road" />
        <text x={px(87.0)} y={py(25.97)} class="road-label">NH-27</text>

        <!-- India–Nepal border -->
        <path d={borderD} class="border" />
        <text x={px(84.45)} y={py(26.78)} class="border-label">NEPAL</text>
        <text x={px(84.45)} y={py(26.45)} class="border-label">INDIA</text>

        <!-- district labels -->
        <g class="districts">
          {districts.map((d) => (<text x={d.x} y={d.y} text-anchor="middle">{d.name}</text>))}
        </g>

        <!-- markers -->
        <g class="markers">
          {
            markers.map((m) => (
              <g class="mk" data-id={m.id} data-type={m.type} data-name={m.name.toLowerCase()} transform={`translate(${m.x.toFixed(1)},${m.y.toFixed(1)})`} style={`--mc:${m.color}`} tabindex="0" role="button" aria-label={m.name}>
                <circle class="mk-halo" r="13" />
                <text class="mk-emoji" y="5.5" text-anchor="middle">{m.emoji}</text>
                <text class="mk-label" y="27" text-anchor="middle">{m.name}</text>
              </g>
            ))
          }
        </g>
      </svg>
    </div>

    <aside class="map-panel" id="map-panel" aria-live="polite">
      <div class="panel-default">
        <h2>Explore Mithila</h2>
        <p>Tap any marker to read about it here. Use the chips above to filter by type, or search by name.</p>
        <p class="panel-hint">🛕 temples · 🏰 palaces · 🎨 art villages · 🏡 villages · 🌳 nature · 🏛️ ancient sites</p>
      </div>
      <div class="panel-detail" hidden>
        <button type="button" class="panel-close" aria-label="Clear selection">×</button>
        <img class="panel-img" alt="" hidden />
        <span class="panel-type"></span>
        <h2 class="panel-name"></h2>
        <p class="panel-blurb"></p>
        <a class="panel-link" href="#" hidden>Open full page →</a>
      </div>
    </aside>
  </div>

  <script type="application/json" id="mapdata" set:html={JSON.stringify(clientData)}></script>
</div>

<style>
  .map-explorer {
    --panel-w: 320px;
  }
  .map-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  #map-search {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    min-width: 220px;
    flex: 1;
  }
  .map-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .chip.active {
    color: #fff;
    background: var(--mc);
    border-color: var(--mc);
  }
  .chip-emoji {
    font-size: 0.9rem;
  }

  .map-stage {
    display: grid;
    grid-template-columns: 1fr var(--panel-w);
    gap: 1.25rem;
    align-items: start;
  }
  .map-canvas {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #e9dcbb;
  }
  .map-canvas svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .band-label {
    font-family: var(--font-ui);
    font-size: 11px;
    fill: #8a7550;
    letter-spacing: 2px;
  }
  .forest text {
    font-size: 18px;
    opacity: 0.8;
  }
  .rivers path {
    fill: none;
    stroke: #3f6f86;
    stroke-width: 2.6;
    opacity: 0.6;
  }
  .river-label {
    font-family: var(--font-ui);
    font-size: 10px;
    fill: #2e5d72;
    font-style: italic;
  }
  .road {
    fill: none;
    stroke: #b08a3e;
    stroke-width: 2;
    stroke-dasharray: 7 5;
    opacity: 0.7;
  }
  .road-label {
    font-family: var(--font-ui);
    font-size: 9px;
    fill: #8a6d2e;
  }
  .border {
    fill: none;
    stroke: #7a6a45;
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
  }
  .border-label {
    font-family: var(--font-ui);
    font-size: 12px;
    fill: #6f5d3a;
    letter-spacing: 2px;
  }
  .districts text {
    font-family: var(--font-display);
    font-size: 13px;
    fill: #9c8a64;
    opacity: 0.65;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .mk {
    cursor: pointer;
  }
  .mk-halo {
    fill: #fff;
    stroke: var(--mc);
    stroke-width: 2;
  }
  .mk-emoji {
    font-size: 15px;
  }
  .mk-label {
    font-family: var(--font-ui);
    font-size: 9.5px;
    fill: #2a2118;
    paint-order: stroke;
    stroke: #e9dcbb;
    stroke-width: 3px;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .mk:hover .mk-halo,
  .mk:focus .mk-halo,
  .mk.selected .mk-halo {
    fill: var(--mc);
  }
  .mk.selected .mk-halo {
    r: 16;
  }
  .mk.hidden {
    display: none;
  }
  .mk.dim {
    opacity: 0.18;
  }

  /* panel */
  .map-panel {
    position: sticky;
    top: 80px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    padding: 1.25rem 1.3rem;
    min-height: 280px;
  }
  .map-panel h2 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }
  .map-panel p {
    color: var(--muted);
    line-height: 1.55;
    font-size: 0.95rem;
    margin: 0 0 0.7rem;
  }
  .panel-hint {
    font-size: 0.85rem !important;
  }
  .panel-detail {
    position: relative;
  }
  .panel-close {
    position: absolute;
    top: -0.4rem;
    right: -0.4rem;
    border: none;
    background: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
  }
  .panel-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.8rem;
  }
  .panel-type {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--mc, var(--color-vermilion));
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .panel-name {
    margin: 0.5rem 0 0.4rem !important;
  }
  .panel-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--link);
    text-decoration: underline;
  }

  @media (max-width: 880px) {
    .map-stage {
      grid-template-columns: 1fr;
    }
    .map-panel {
      position: static;
    }
  }
</style>

<script>
  const root = document.querySelector('.map-explorer');
  if (root) {
    const data = JSON.parse(document.getElementById('mapdata')?.textContent || '{}');
    const markers = Array.from(root.querySelectorAll<SVGGElement>('.mk'));
    const panel = root.querySelector('#map-panel') as HTMLElement;
    const def = panel.querySelector('.panel-default') as HTMLElement;
    const det = panel.querySelector('.panel-detail') as HTMLElement;
    const img = det.querySelector('.panel-img') as HTMLImageElement;
    const typeEl = det.querySelector('.panel-type') as HTMLElement;
    const nameEl = det.querySelector('.panel-name') as HTMLElement;
    const blurbEl = det.querySelector('.panel-blurb') as HTMLElement;
    const linkEl = det.querySelector('.panel-link') as HTMLAnchorElement;
    const closeBtn = det.querySelector('.panel-close') as HTMLButtonElement;
    const search = root.querySelector('#map-search') as HTMLInputElement;
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
    const active = new Set(chips.map((c) => c.dataset.filter));

    function select(id: string) {
      const d = data[id];
      if (!d) return;
      markers.forEach((m) => m.classList.toggle('selected', m.dataset.id === id));
      def.hidden = true;
      det.hidden = false;
      det.style.setProperty('--mc', d.color);
      if (d.img) {
        img.src = d.img;
        img.alt = d.name;
        img.hidden = false;
      } else {
        img.hidden = true;
      }
      typeEl.textContent = d.typeLabel;
      nameEl.textContent = d.emoji + '  ' + d.name;
      blurbEl.textContent = d.blurb;
      if (d.href) {
        linkEl.href = d.href;
        linkEl.hidden = false;
      } else {
        linkEl.hidden = true;
      }
    }
    function clearSel() {
      markers.forEach((m) => m.classList.remove('selected'));
      det.hidden = true;
      def.hidden = false;
    }

    markers.forEach((m) => {
      const open = () => select(m.dataset.id!);
      m.addEventListener('click', open);
      m.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });
    closeBtn.addEventListener('click', clearSel);

    function applyFilters() {
      const q = (search.value || '').trim().toLowerCase();
      markers.forEach((m) => {
        const okType = active.has(m.dataset.type);
        const okText = !q || (m.dataset.name || '').includes(q);
        m.classList.toggle('hidden', !okType);
        m.classList.toggle('dim', okType && !okText);
      });
    }
    chips.forEach((c) => {
      c.addEventListener('click', () => {
        const t = c.dataset.filter!;
        if (active.has(t)) {
          active.delete(t);
          c.classList.remove('active');
          c.setAttribute('aria-pressed', 'false');
        } else {
          active.add(t);
          c.classList.add('active');
          c.setAttribute('aria-pressed', 'true');
        }
        applyFilters();
      });
    });
    search.addEventListener('input', applyFilters);
  }
</script>
