---
// A slim "today's panchang" strip for the homepage. Client JS shows the real
// current day's tithi/nakshatra (from the precomputed year JSON) plus any
// festival or no-ceremony period today, and links into the full Panchang.
import { localizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/locales';
import { FESTIVALS, WINDOWS } from '../../data/panchang';

const { lang } = Astro.props as { lang: Locale };
const compact = JSON.stringify({
  fest: FESTIVALS.filter((f) => f.major || f.link).map((f) => ({ d: f.date, e: f.endDate, dev: f.dev, en: f.en })),
  win: WINDOWS.map((w) => ({ s: w.start, e: w.end, dev: w.dev })),
});
const href = localizedPath(lang, '/panchang/');
---
<a class="pch-strip" href={href} aria-label="Today's Maithili Panchang">
  <span class="pch-strip-cal">
    <span class="pch-strip-day" id="hps-day">·</span>
    <span class="pch-strip-mon" id="hps-mon">2026</span>
  </span>
  <span class="pch-strip-body">
    <span class="pch-strip-kicker">आजुक पंचांग · Today in Mithila</span>
    <span class="pch-strip-main" id="hps-main">पंचांग देखू…</span>
    <span class="pch-strip-special" id="hps-special" hidden></span>
  </span>
  <span class="pch-strip-arrow" aria-hidden="true">→</span>
</a>
<script type="application/json" id="hps-data" set:html={compact}></script>

<script>
  (async () => {
    const main = document.getElementById('hps-main');
    if (!main) return;
    const dataEl = document.getElementById('hps-data');
    const data = JSON.parse(dataEl?.textContent || '{}') as {
      fest: { d: string; e?: string; dev?: string; en: string }[];
      win: { s: string; e: string; dev: string }[];
    };
    const pad = (n: number) => String(n).padStart(2, '0');
    const t = new Date();
    let iso = `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}`;
    if (iso < '2026-01-01') iso = '2026-01-01';
    if (iso > '2026-12-31') iso = '2026-12-31';
    const dayEl = document.getElementById('hps-day');
    const monEl = document.getElementById('hps-mon');
    if (dayEl) dayEl.textContent = String(Number(iso.slice(8, 10)));
    if (monEl) monEl.textContent = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Number(iso.slice(5, 7)) - 1];
    try {
      const r = await fetch('/data/panchang-2026.json');
      const j = await r.json();
      const dd = j.days.find((x: any) => x.d === iso);
      if (dd) main.textContent = `${dd.wdDev} · ${dd.sm} ${dd.pak} ${dd.tithi} · नक्षत्र ${dd.nak}`;
    } catch {
      main.textContent = 'पूरा पंचांग देखू';
    }
    const win = (data.win || []).find((w) => iso >= w.s && iso <= w.e);
    const fest = (data.fest || []).find((f) => iso === f.d || (f.e && iso >= f.d && iso <= f.e));
    const sp = document.getElementById('hps-special');
    if (sp) {
      if (fest) { sp.textContent = '🪔 ' + (fest.dev || fest.en); sp.hidden = false; }
      else if (win) { sp.textContent = '⛔ ' + win.dev; sp.hidden = false; }
    }
  })();
</script>

<style>
  .pch-strip {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    max-width: 72rem;
    margin: 1.6rem auto 0;
    padding: 0.85rem 1.2rem;
    border: 1px solid color-mix(in srgb, #b8860b 40%, var(--line));
    background: color-mix(in srgb, #b8860b 9%, var(--surface));
    border-radius: 14px;
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.16s ease, background 0.16s ease;
  }
  .pch-strip:hover {
    border-color: #b8860b;
    background: color-mix(in srgb, #b8860b 14%, var(--surface));
  }
  .pch-strip-cal {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #b8860b;
    color: #fff;
    line-height: 1;
  }
  .pch-strip-day { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; }
  .pch-strip-mon { font-family: var(--font-ui); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }
  .pch-strip-body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; flex: 1; }
  .pch-strip-kicker { font-family: var(--font-ui); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: #b8860b; font-weight: 700; }
  .pch-strip-main { font-size: 1.05rem; color: var(--fg); }
  .pch-strip-special { font-family: var(--font-ui); font-size: 0.85rem; color: var(--muted); margin-top: 0.1rem; }
  .pch-strip-arrow { flex-shrink: 0; font-size: 1.3rem; color: #b8860b; }
  @media (max-width: 560px) {
    .pch-strip { gap: 0.8rem; padding: 0.75rem 0.9rem; }
    .pch-strip-main { font-size: 0.98rem; }
    .pch-strip-arrow { display: none; }
  }
</style>
